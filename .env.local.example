# ───────────────────────────────────────────────
# DeepSeek（对话大模型）
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-你的真实Key放这里

# ───────────────────────────────────────────────
# Clerk（仅研究者 / admin 登录用，参与者免登）
# 控制台：https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Webhook 签名密钥：Dashboard → Webhooks → 添加端点 /api/clerk-webhook
CLERK_WEBHOOK_SECRET=whsec_xxx

# ───────────────────────────────────────────────
# Supabase（Postgres + Storage）
# 控制台：https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxx.service_role

# ───────────────────────────────────────────────
# 研究者（admin）邮箱，逗号分隔；仅这些邮箱可访问 /admin 后台
ADMIN_EMAILS=admin@example.com
